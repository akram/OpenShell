# RHOAIENG-97009: UBI-based variant of Dockerfile.gateway.multistage for the
# crypto-openssl backend. Builder and runtime share the same UBI9 glibc/OpenSSL
# base (no cross-compilation, no Nix) so the gateway binary dynamically links
# against the same system libcrypto/libssl it was built against, matching the
# "dynamic linking to the intended system OpenSSL and provider package in the
# supported runtime image" requirement in crates/openshell-crypto/CRYPTO.md.
#
# Requires [patch.crates-io] in the workspace Cargo.toml pointing russh/ssh-key
# at the akram/russh (feat/optional-openssl-gcm-backend) and
# akram/rust-ssh-key (feat/openssl-rsa-backend) forks.

# ---- Builder: UBI9-minimal + rustup, native build (no cross, no Nix) --------
#
# ubi9/ubi (the full image) ships shadow-utils' newuidmap/newgidmap with a
# security.capability xattr baked into its layer; Kaniko's unprivileged
# executor can't re-apply that xattr while unpacking the base image
# ("lsetxattr ... operation not permitted"). ubi9/ubi-minimal doesn't carry
# those binaries, so it unpacks cleanly under the same unprivileged SCC.
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.6 AS builder

RUN microdnf install -y --setopt=install_weak_deps=0 \
      gcc git pkgconf-pkg-config openssl-devel tar ca-certificates \
    && microdnf clean all

# z3's C++ bindings need libstdc++ (-lstdc++) at final link time; the base
# gcc install doesn't carry it. z3-devel itself (-lz3 + headers) isn't
# packaged in UBI9's baseos/appstream/CRB repos (EPEL-only).
#
# TODO(RHOAIENG-97009): this pulls z3-devel from EPEL9, an unofficial,
# non-Red-Hat-supported repo -- fine for this feasibility build, but a
# FIPS-certifiable final image should instead use z3/vendored (build z3
# from source against the same toolchain) or an officially supported
# package. The GitHub-releases prebuilt-z3 feature was tried first but its
# libz3 archive is linked against a newer glibc/libstdc++ ABI than UBI9
# ships (undefined __isoc23_* / std::to_chars symbols at link time).
RUN microdnf install -y --setopt=install_weak_deps=0 gcc-c++ \
    && curl -sSL -o /tmp/epel.rpm https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && rpm -ivh /tmp/epel.rpm \
    && microdnf install -y --setopt=install_weak_deps=0 z3-devel \
    && rpm -e epel-release \
    && rm -f /tmp/epel.rpm \
    && microdnf clean all

ENV HOME=/root \
    PATH=/root/.cargo/bin:${PATH} \
    CARGO_AUDITABLE_VERSION=0.6.7

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --default-toolchain stable --profile minimal && \
    cargo install cargo-auditable --version ${CARGO_AUDITABLE_VERSION} --locked

WORKDIR /build
COPY . .

# System OpenSSL (openssl-devel, pulled in above) is what openssl-sys links
# against here and in the runtime stage below; no vendored/static OpenSSL.
RUN GIT_DIR=/nonexistent cargo auditable build --release \
      --package openshell-gateway --bin openshell-gateway \
      --no-default-features --features "telemetry,in-tree-compute-drivers,crypto-openssl" && \
    cp target/release/openshell-gateway /openshell-gateway && \
    cd / && rm -rf /build /root/.cargo/registry /root/.cargo/git /root/.cache

# ---- Runtime: UBI9-minimal, FIPS-mode system OpenSSL -------------------------
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.6 AS gateway

RUN microdnf install -y --setopt=install_weak_deps=0 \
      openssl-libs crypto-policies crypto-policies-scripts libstdc++ \
    && update-crypto-policies --set FIPS \
    && curl -sSL -o /tmp/epel.rpm https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && rpm -ivh /tmp/epel.rpm \
    && microdnf install -y --setopt=install_weak_deps=0 z3-libs \
    && rpm -e epel-release \
    && rm -f /tmp/epel.rpm \
    && microdnf clean all

ARG TARGETARCH

WORKDIR /app
RUN chown 1000:1000 /app

COPY --from=builder /openshell-gateway /usr/local/bin/openshell-gateway

# Unlike distroless:nonroot, UBI9-minimal has no HOME set for uid 1000 by
# default; the gateway's state dir resolves under $HOME and fails to create
# ("Permission denied") without this.
ENV HOME=/app
USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
